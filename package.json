{
  "name": "ican-career-suite",
  "version": "2.0.7",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.3.0",
  "scripts": {
    "dev": "pnpm --filter @ican/web dev",
    "build": "pnpm --filter @ican/web build",
    "start": "pnpm --filter @ican/web start",
    "preview": "pnpm --filter @ican/web preview",
    "resume": "node packages/cli/src/magic-resume-cli.mjs",
    "cli": "node packages/cli/src/magic-resume-cli.mjs",
    "check": "pnpm --filter @ican/web check && pnpm --filter @ican/magic-resume-cli check",
    "release": "bumpp",
    "generate:template-snapshots": "pnpm --filter @ican/web generate:template-snapshots",
    "export:resume-assets": "pnpm --filter @ican/web export:resume-assets",
    "install:playwright": "pnpm --filter @ican/web install:playwright",
    "install:skills": "node scripts/install-skills.mjs"
  },
  "devDependencies": {
    "bumpp": "^10.4.1",
    "changelogen": "^0.6.2"
  }
}
