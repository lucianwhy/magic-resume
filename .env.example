# Required before enabling /api/resumes. Generate a long random value.
RESUME_API_KEY=replace-with-a-long-random-secret

# Container default: /data/resumes. Local default: .data/resumes.
RESUME_DATA_DIR=/data/resumes

# Optional: enables a private one-click browser import for exactly this resume ID.
RESUME_DEFAULT_ID=wang-haoyue-ai-application-intern
RESUME_BOOTSTRAP_TOKEN=replace-with-a-second-long-random-secret
